<Window x:Class="ColorPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Color Panel" Width="760" Height="620" MinWidth="760" MinHeight="620"
        ResizeMode="CanResize" WindowStyle="None" AllowsTransparency="False"
        Background="Transparent" Foreground="#F2F2F7" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#7FDBFF"/>
    <SolidColorBrush x:Key="Sub" Color="#A3B8C8"/>
    <SolidColorBrush x:Key="CardBg" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Hover" Color="#2EFFFFFF"/>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="4,14,0,8"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,14,16,4"/>
    </Style>

    <Style x:Key="SliderFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2E86C1" Offset="0"/><GradientStop Color="#9FE6FF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderEmpty" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" Height="22"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Ellipse Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="3"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GlassSlider" TargetType="Slider">
      <Setter Property="Height" Value="22"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center" Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="#33FFFFFF"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SliderThumb}"/>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Bd" CornerRadius="3" Background="#44FFFFFF" Margin="1,0"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#77FFFFFF"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#99FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SegBtn" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="8" Padding="16,7" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="#0B1A26"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="8" Padding="14,7" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Foreground" Value="#0B1A26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Padding="24,10" Background="{StaticResource Accent}">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="8" Padding="14,10" Background="Transparent">
              <Grid>
                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                        Margin="-8,0,0,0" Background="{StaticResource Accent}" Visibility="Collapsed"/>
                <ContentPresenter/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBg}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Padding="14,8" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PresetCard" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Width" Value="196"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Padding="14,12" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="#44FFFFFF">
              <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                       HorizontalAlignment="Left" Margin="4,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TitleBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Background="#66101C28">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Barre laterale -->
    <Border Grid.Column="0" Background="#33000000" BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0">
      <Grid Margin="16,16,16,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,6,0,28">
          <Ellipse Width="14" Height="14" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
          <TextBlock Text="COLOR PANEL" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <RadioButton x:Name="NavAdjust" Content="Réglages" Style="{StaticResource NavItem}" Checked="OnNav"/>
          <RadioButton x:Name="NavPresets" Content="Presets" Style="{StaticResource NavItem}" Checked="OnNav"/>
          <RadioButton x:Name="NavDisplay" Content="Affichage" Style="{StaticResource NavItem}" Checked="OnNav"/>
          <RadioButton x:Name="NavAbout" Content="Infos" Style="{StaticResource NavItem}" Checked="OnNav"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12">
          <StackPanel>
            <Grid>
              <TextBlock x:Name="StateText" Text="Effet actif" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <ToggleButton x:Name="ChkOn" Style="{StaticResource Switch}" IsChecked="True"
                            HorizontalAlignment="Right"/>
            </Grid>
            <TextBlock Text="Ctrl + Alt + C" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Contenu -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <TextBlock x:Name="PageTitle" Text="Réglages" FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="24,0,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,6,0" VerticalAlignment="Top">
          <Button Style="{StaticResource TitleBtn}" Content="&#x2014;" Click="OnMinimize"/>
          <Button Style="{StaticResource TitleBtn}" Content="&#x25A1;" Click="OnMaximize"/>
          <Button Style="{StaticResource TitleBtn}" Content="&#x2715;" Click="OnClose"/>
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
        <Grid>
          <StackPanel x:Name="PageAdjust">
            <Grid Margin="0,4,0,0">
              <Border HorizontalAlignment="Left" CornerRadius="10" Padding="3" Background="{StaticResource CardBg}"
                      BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="RbDash" Content="Dashboard" GroupName="view" Style="{StaticResource SegBtn}" Checked="OnView"/>
                  <RadioButton x:Name="RbSliders" Content="Curseurs" GroupName="view" Style="{StaticResource SegBtn}" Checked="OnView"/>
                </StackPanel>
              </Border>
              <Button Content="Tout réinitialiser" HorizontalAlignment="Right" Margin="0"
                      Style="{StaticResource GhostButton}" Click="OnReset"/>
            </Grid>
            <StackPanel x:Name="DashView"/>
            <StackPanel x:Name="SlidersView" Visibility="Collapsed"/>
          </StackPanel>

          <StackPanel x:Name="PagePresets" Visibility="Collapsed">
            <TextBlock Text="BIBLIOTHÈQUE DE PRESETS" Style="{StaticResource Section}"/>
            <StackPanel x:Name="PresetsPanel"/>
            <TextBlock Text="MES PRESETS" Style="{StaticResource Section}"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Sauver mes réglages" Style="{StaticResource GhostButton}" Click="OnSave"/>
              <Button Content="Charger un preset" Style="{StaticResource GhostButton}" Click="OnLoad"/>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="PageDisplay" Visibility="Collapsed">
            <TextBlock Text="ÉCRAN" Style="{StaticResource Section}" Margin="4,4,0,8"/>
            <WrapPanel x:Name="MonPanel"/>

            <!-- Carte principale : moniteur + résumé -->
            <Border Style="{StaticResource Card}" Padding="20,18,20,14" Margin="0,8,0,0" BorderBrush="#557FDBFF">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#337FDBFF" Offset="0"/>
                  <GradientStop Color="#10FFFFFF" Offset="0.6"/>
                  <GradientStop Color="#1AFFFFFF" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <Grid Height="140">
                    <Border x:Name="MonitorShape" Width="220" Height="124" CornerRadius="8" BorderThickness="3"
                            BorderBrush="#E6FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Border.Effect>
                        <DropShadowEffect Color="#7FDBFF" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
                      </Border.Effect>
                      <Border CornerRadius="5" Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                              Margin="0,0,0,8" Padding="8,2">
                        <TextBlock x:Name="MonitorText" FontWeight="SemiBold" FontSize="12"/>
                      </Border>
                    </Border></Grid>
                  <Border Width="26" Height="10" Background="#55FFFFFF" HorizontalAlignment="Center"/>
                  <Border Width="90" Height="5" CornerRadius="3" Background="#55FFFFFF" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="BigRes" FontSize="34" FontWeight="Bold">
                    <TextBlock.Foreground>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#7FDBFF" Offset="1"/>
                      </LinearGradientBrush>
                    </TextBlock.Foreground>
                  </TextBlock>
                  <TextBlock x:Name="BigHz" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,2,0,0"/>
                  <WrapPanel Margin="0,14,0,0">
                    <Border x:Name="StateBadge" Style="{StaticResource Badge}"><TextBlock x:Name="StateText2" FontSize="11" FontWeight="SemiBold"/></Border>
                    <Border Style="{StaticResource Badge}"><TextBlock x:Name="ResClassText" FontSize="11" FontWeight="SemiBold"/></Border>
                    <Border Style="{StaticResource Badge}"><TextBlock x:Name="HzClassText" FontSize="11" FontWeight="SemiBold"/></Border>
                    <Border Style="{StaticResource Badge}"><TextBlock x:Name="RatioText" FontSize="11"/></Border>
                    <Border Style="{StaticResource Badge}"><TextBlock x:Name="MpText" FontSize="11"/></Border>
                    <Border Style="{StaticResource Badge}"><TextBlock x:Name="PctText" FontSize="11"/></Border>
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="RACCOURCIS" Style="{StaticResource Section}"/>
            <WrapPanel x:Name="QuickPanel"/>

            <!-- Réglages -->
            <TextBlock Text="RÉGLAGES" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}" Padding="18,14,18,6">
              <StackPanel>
                <Grid>
                  <TextBlock Text="Résolution"/>
                  <TextBlock x:Name="ResValue" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                </Grid>
                <Slider x:Name="ResSlider" Style="{StaticResource GlassSlider}" Margin="0,6,0,14" Minimum="0" Maximum="1"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnResSlider"/>
                <Grid>
                  <TextBlock Text="Fréquence"/>
                  <TextBlock x:Name="HzValue" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                </Grid>
                <Slider x:Name="HzSlider" Style="{StaticResource GlassSlider}" Margin="0,6,0,14" Minimum="0" Maximum="1"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnHzSlider"/>
                <Grid>
                  <TextBlock Text="Mise à l'échelle (barres noires)"/>
                  <TextBlock x:Name="ScaleValue" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                </Grid>
                <Slider x:Name="ScaleSlider" Style="{StaticResource GlassSlider}" Margin="0,6,0,8" Minimum="0" Maximum="2"
                        Value="1" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnScaleSlider"/>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Content="Appliquer" Style="{StaticResource AccentButton}" Click="OnApplyMode"/>
              <Button Content="Actualiser" Style="{StaticResource GhostButton}" Padding="14,10" Click="OnRefreshModes"/>
            </StackPanel>

            <Border x:Name="ConfirmCard" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,14,0,0" Padding="16,14,16,14"
                    BorderBrush="{StaticResource Accent}">
              <StackPanel>
                <TextBlock x:Name="ConfirmText" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Garder" Style="{StaticResource AccentButton}" Click="OnKeepMode"/>
                  <Button Content="Annuler" Style="{StaticResource GhostButton}" Padding="14,10" Click="OnRevertMode"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock x:Name="DispInfo" Foreground="{StaticResource Sub}" FontSize="11" Margin="2,14,0,0" TextWrapping="Wrap"/>
            <TextBlock Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,12"
                       Text="Seuls les modes proposés par ton écran et ton pilote sont listés. Si l'image disparaît, l'ancien mode revient tout seul après 15 secondes."/>
          </StackPanel>

          

          <StackPanel x:Name="PageAbout" Visibility="Collapsed">
            <TextBlock Text="À PROPOS" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}" Padding="16,14,16,14">
              <StackPanel>
                <TextBlock Text="Color Panel v1.1" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,8,0,0"
                  Text="Contrôle les couleurs de tout l'écran via l'API Magnification de Windows. Aucune injection de DLL dans les jeux."/>
                <TextBlock Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,10,0,0"
                  Text="Astuce : double-clique sur un curseur pour le remettre à sa valeur par défaut."/>
                <TextBlock Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,10,0,0"
                  Text="Pour de meilleurs résultats, joue en plein écran fenêtré (borderless). Le plein écran exclusif peut ignorer l'effet."/>
                <TextBlock Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11" Text="Photos d'aperçu : Wikimedia Commons (domaine public, CC0 ou CC BY, voir photos\CREDITS.txt) et tes propres images."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <TextBlock Grid.Row="2" x:Name="Status" Foreground="{StaticResource Sub}" FontSize="11"
                 Margin="24,8,24,12" TextWrapping="Wrap"/>
    </Grid>
  </Grid>
</Window>











